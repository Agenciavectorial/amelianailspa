{
  "name": "amelianailspa",
  "private": true,
  "description": "Página y plataforma de citas de Amelia Nail Spa (Cloudflare Pages + D1)",
  "scripts": {
    "dev": "node dev/servidor.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/*.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 dev/e2e.test.mjs",
    "db:migrar:local": "wrangler d1 migrations apply amelia-citas --local",
    "db:migrar:remoto": "wrangler d1 migrations apply amelia-citas --remote"
  },
  "devDependencies": {
    "wrangler": "^4.166.0"
  },
  "type": "module"
}
